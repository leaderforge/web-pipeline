# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# DeepSeek API (V2 — inteligencia real)
# Obtener API key en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# Cost tracking (per 1M tokens, USD)
DEEPSEEK_INPUT_COST_PER_1M=0.50
DEEPSEEK_OUTPUT_COST_PER_1M=2.00

# Railway service port
PORT=8080

# ── GitHub Sync (vault ↔ Railway) ─────────────────────────────────
# Token with repo scope: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# Webhook secret for /webhook/github endpoint
# Generate: python -c "import secrets; print(secrets.token_hex(20))"
# Then configure webhook at: https://github.com/leaderforge/Hermes-Brain/settings/hooks
# Payload URL: https://hermes-telegram-production.up.railway.app/webhook/github
# Content type: application/json | Events: Just the push event
WEBHOOK_SECRET=change_me_secret_32chars

# Branch that bot writes to (never auto-merged into master)
VAULT_BRANCH_AI=ai-memory

# Debounce window for webhook events (seconds)
WEBHOOK_DEBOUNCE_S=60

# Number of auto-backups to retain before pruning
BACKUP_RETENTION=10

# ── Claude Code Bridge ────────────────────────────────────────────
# Secret for /notify endpoint (Claude Code → Telegram bridge)
NOTIFY_SECRET=change_me_too

