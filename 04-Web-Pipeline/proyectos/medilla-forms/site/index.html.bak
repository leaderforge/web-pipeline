    <i class="ph-fill ph-whatsapp-logo text-white text-[28px]"></i>
  </a>
</div>

<script>
(function(){
  // Reveal on scroll
  new IntersectionObserver((e)=>e.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')}),{threshold:0.1,rootMargin:'0px 0px -20px 0px'}).observe(document.querySelector('header'));
  document.querySelectorAll('.reveal').forEach(el=>new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')})},{threshold:0.1,rootMargin:'0px 0px -20px 0px'}).observe(el));

  // Sticky WhatsApp
  var wa=document.getElementById('stickyWa'),hero=document.querySelector('header');
  new IntersectionObserver((e)=>{e.forEach(e=>{e.isIntersecting?wa.classList.remove('on'):wa.classList.add('on')})},{threshold:0,rootMargin:'-60px 0px 0px 0px'}).observe(hero);

  // Track WhatsApp clicks
  function track(n,p){p=p||{};if(typeof gtag=='function')gtag('event',n,p);if(typeof fbq=='function')fbq('track',n,p)}
  document.querySelectorAll('a[href*="wa.me"]').forEach(l=>l.addEventListener('click',()=>{
    track('Lead',{content_name:'whatsapp_click',content_category:'lead'});
    fetch('https://api.medillaforms.com/api/track/landing-click',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({referrer:document.referrer||'directo'}),
      keepalive:true
    }).catch(()=>{});
  }));

  // ═══ EXIT INTENT POPUP ═══
  var exitShown = false;
  var exitPopup = document.createElement('div');
  exitPopup.id = 'exit-popup';
  exitPopup.innerHTML = '<div style="position:fixed;inset:0;background:rgba(0,0,0,0.65);backdrop-filter:blur(8px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;transition:opacity 0.4s cubic-bezier(0.32,0.72,0,1)"><div style="background:#fff;border-radius:1.5rem;padding:2rem 1.5rem;max-width:380px;width:100%;text-align:center;position:relative;box-shadow:0 20px 60px rgba(0,0,0,0.3);transform:scale(0.9);transition:transform 0.4s cubic-bezier(0.32,0.72,0,1)"><button onclick="document.getElementById(\'exit-popup\').style.opacity=\'0\';setTimeout(function(){document.getElementById(\'exit-popup\').remove()},400)" style="position:absolute;top:12px;right:14px;background:none;border:none;font-size:20px;cursor:pointer;color:#94a3b8;padding:4px 8px">&times;</button><span style="display:inline-block;background:#fef3c7;color:#92400e;padding:4px 12px;border-radius:50px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;margin-bottom:12px">Oferta especial</span><p style="font-family:\'Clash Display\',\'Plus Jakarta Sans\',sans-serif;font-weight:700;font-size:1.6rem;line-height:1.15;color:#0f172a;margin-bottom:8px">¡Espera!</p><p style="color:#64748b;font-size:15px;line-height:1.5;margin-bottom:20px">Llévate tus dos cartas de disputa por <strong style="color:#0d9488">$24 USD</strong> en vez de $29.</p><a href="https://wa.me/12139054680?text=Hola%2C%20vi%20la%20oferta%20de%20%2424%20USD" target="_blank" style="display:inline-flex;align-items:center;gap:8px;background:#25D366;color:#fff;font-weight:600;font-size:15px;padding:12px 28px;border-radius:50px;text-decoration:none;transition:all 0.3s"><i class="ph ph-whatsapp-logo" style="font-size:20px"></i> Hablar por WhatsApp <span style="font-size:14px">→</span></a><p style="color:#94a3b8;font-size:11px;margin-top:12px">Te atendemos al instante · Sin compromiso</p></div></div>';
  exitPopup.style.opacity = '0';
  exitPopup.style.position = 'fixed';
  exitPopup.style.inset = '0';
  exitPopup.style.zIndex = '9999';
  exitPopup.style.pointerEvents = 'none';
  document.body.appendChild(exitPopup);

  // Desktop exit intent — mouse truly leaves the document (not just a child element)
  document.addEventListener('mouseout', function(e) {
    if (exitShown) return;
    // e.relatedTarget === null → mouse left the entire document
    // e.clientY <= 5 → exited through the TOP edge
    if (!e.relatedTarget && e.clientY <= 5) {
      exitShown = true;
      track('ViewContent',{content_name:'exit_popup_24',content_category:'offer'});
      exitPopup.style.pointerEvents = 'auto';
      exitPopup.style.opacity = '1';
      var inner = exitPopup.querySelector('div > div');
      if (inner) inner.style.transform = 'scale(1)';
    }
  });

  // Mobile exit intent — scroll-up after scrolling past 40% of page
  var lastScrollY = 0;
  var lastScrollTime = Date.now();
  var deepScrolled = false;
  var depth50fired = false;
  var depth75fired = false;
  var ticking = false;
  document.addEventListener('scroll', function() {
    if (exitShown || ticking) return;
    ticking = true;
    requestAnimationFrame(function() {
      var now = Date.now();
      var sy = window.scrollY;
      var docH = document.documentElement.scrollHeight - window.innerHeight;
      var pct = docH > 0 ? sy / docH : 0;

      // Scroll depth events for Meta Pixel
      if (!depth50fired && pct > 0.50) { depth50fired = true; track('ScrollDepth',{percent:50}); }
      if (!depth75fired && pct > 0.75) { depth75fired = true; track('ScrollDepth',{percent:75}); }

      if (pct > 0.40) deepScrolled = true;

      if (deepScrolled) {
        var delta = lastScrollY - sy;       // + = scrolling up
        var dt = (now - lastScrollTime) / 1000; // seconds
        var speed = dt > 0.05 ? delta / dt : 0;   // px/s

        // Trigger on noticeable scroll-up (40px+ at 150px/s+)
        if (delta > 40 && speed > 150) {
          exitShown = true;
          track('ViewContent',{content_name:'exit_popup_24_mobile',content_category:'offer'});
          exitPopup.style.pointerEvents = 'auto';
          exitPopup.style.opacity = '1';
          var inner = exitPopup.querySelector('div > div');
          if (inner) inner.style.transform = 'scale(1)';
        }
      }

      lastScrollY = sy;
      lastScrollTime = now;
      ticking = false;
    });
  }, {passive: true});
})();</script>

