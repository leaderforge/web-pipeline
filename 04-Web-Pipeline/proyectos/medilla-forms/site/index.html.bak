<style>
  :root { --ease-spring: cubic-bezier(0.32,0.72,0,1); }
  * { -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale; }
  html { scroll-behavior:smooth; }

  .reveal { opacity:0; transform:translateY(24px); transition:opacity 0.7s var(--ease-spring),transform 0.7s var(--ease-spring); }
  .reveal.visible { opacity:1; transform:translateY(0); }
  .reveal-d1 { transition-delay:0.1s; } .reveal-d2 { transition-delay:0.2s; } .reveal-d3 { transition-delay:0.3s; } .reveal-d4 { transition-delay:0.4s; }

  .btn-wa {
    transition: all 0.35s var(--ease-spring);
    min-height: 52px;
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  }
  .btn-wa:hover { transform: scale(1.03); box-shadow: 0 8px 32px rgba(13,148,136,0.4); }
  .btn-wa:active { transform: scale(0.97); }

  .card {
    background:#fff;
    border-radius:1.25rem;
    padding:1.5rem;
    border:1px solid rgba(0,0,0,0.05);
    box-shadow:0 1px 2px rgba(0,0,0,0.02),0 4px 12px rgba(0,0,0,0.03);
    transition:box-shadow 0.4s var(--ease-spring),transform 0.4s var(--ease-spring);
  }
  .card:hover { box-shadow:0 4px 24px rgba(0,0,0,0.06); }

  .nav-glass {
    background:rgba(255,255,255,0.88);
    backdrop-filter:blur(20px) saturate(180%);
    -webkit-backdrop-filter:blur(20px) saturate(180%);
    border:1px solid rgba(0,0,0,0.05);
  }

  @keyframes waPulse { 0%,100%{box-shadow:0 0 0 0 rgba(37,211,102,0.35)} 50%{box-shadow:0 0 0 18px rgba(37,211,102,0)} }
  .wa-pulse { animation:waPulse 2.5s ease-in-out infinite; }

  @keyframes heartbeat { 0%,100%{transform:scale(1)} 12%{transform:scale(1.12)} 24%{transform:scale(1)} 36%{transform:scale(1.12)} 48%{transform:scale(1)} }
  .heartbeat { animation:heartbeat 3.5s ease-in-out infinite; }

  .sticky-wa {
    position:fixed; bottom:20px; right:16px; z-index:50;
    opacity:0; transform:translateY(20px) scale(0.8); pointer-events:none;
    transition:opacity 0.5s var(--ease-spring),transform 0.5s var(--ease-spring);
  }
  .sticky-wa.on { opacity:1; transform:translateY(0) scale(1); pointer-events:auto; }

  .hero-video-frame {
    border-radius:1.25rem;
    overflow:hidden;
    box-shadow:0 4px 16px rgba(0,0,0,0.06),0 16px 48px rgba(0,0,0,0.08);
    border:1px solid rgba(0,0,0,0.04);
  }
  .hero-video-frame video { display:block; width:100%; height:auto; }

  .stat-number {
    font-feature-settings: 'tnum';
    font-variant-numeric: tabular-nums;
  }

  @media (max-width:767px) {
    .btn-wa { min-height:48px; font-size:15px; padding-left:1.25rem; padding-right:1.25rem; }
  }

  .source-tag {
    font-size:11px;
    color:#94a3b8;
    letter-spacing:0.04em;
  }

  .social-link {
    width:44px; height:44px;
    display:flex; align-items:center; justify-content:center;
    border-radius:50%;
    transition:all 0.3s var(--ease-spring);
    background:rgba(255,255,255,0.08);
    color:#94a3b8;
  }
  .social-link:hover { background:rgba(255,255,255,0.15); transform:scale(1.15); }
  .social-link.ig:hover { color:#E4405F; background:rgba(228,64,95,0.15); }
  .social-link.fb:hover { color:#1877F2; background:rgba(24,119,242,0.15); }
  .social-link.wa:hover { color:#25D366; background:rgba(37,211,102,0.15); }
  .social-link.tk:hover { color:#ff0050; background:rgba(255,0,80,0.15); }
</style>

